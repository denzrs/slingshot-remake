{
  "name": "slingshot",
  "version": "1.0.0",
  "description": "Slingshot – Gravitations-Artillerieduell im Weltraum (Web-Remake)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "cargo build --locked --manifest-path server/Cargo.toml",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "shot": "tsx scripts/shot.ts",
    "screens": "tsx scripts/screens.ts",
    "screens:quick": "tsx scripts/screens.ts --quick",
    "dev:server": "DEV_SERVER=1 cargo run --release --manifest-path server/Cargo.toml",
    "dev:server:stats": "DEV_SERVER=1 cargo run --release --manifest-path server/Cargo.toml -- --stats",
    "dev:server:stats-demo": "DEV_SERVER=1 cargo run --release --manifest-path server/Cargo.toml -- --stats-demo",
    "build:server": "cargo build --locked --release --manifest-path server/Cargo.toml",
    "bench:relay": "tsx benchmarks/relay-perf.ts",
    "bench:powerups": "tsx benchmarks/powerups.ts",
    "bench:multikill": "tsx benchmarks/multi-kill.ts",
    "bench:stats": "tsx benchmarks/stats-perf.ts",
    "bench:client": "tsx benchmarks/client-perf.ts",
    "bench:browser": "tsx benchmarks/browser-perf.ts"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@fontsource/b612": "^5.3.0",
    "@fontsource/b612-mono": "^5.3.0",
    "@fontsource/big-shoulders-stencil-display": "^5.3.0",
    "msgpackr": "^2.1.0"
  },
  "private": true
}

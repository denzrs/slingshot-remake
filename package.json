{
  "name": "slingshot",
  "version": "1.0.0",
  "description": "Slingshot – Gravitations-Artillerieduell im Weltraum (Web-Remake)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "npm run build:server",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:server": "cargo run --release --manifest-path server/Cargo.toml",
    "build:server": "cargo build --release --manifest-path server/Cargo.toml",
    "bench:experimental": "tsx benchmarks/ai-matrix.ts",
    "bench:levels": "tsx benchmarks/level-matrix.ts",
    "bench:learning": "tsx benchmarks/learning-validation.ts",
    "bench:calibration": "tsx benchmarks/ai-calibration.ts",
    "bench:relay": "tsx benchmarks/relay-perf.ts"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@fontsource/b612": "^5.3.0",
    "@fontsource/b612-mono": "^5.3.0",
    "@fontsource/big-shoulders-stencil-display": "^5.3.0"
  },
  "private": true
}

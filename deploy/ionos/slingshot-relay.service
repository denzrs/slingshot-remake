[Unit]
Description=Slingshot multiplayer relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=slingshot
Group=slingshot
SupplementaryGroups=ssl-cert
WorkingDirectory=/srv/slingshot/current
EnvironmentFile=/srv/slingshot/current/relay.env
ExecStart=/srv/slingshot/current/slingshot-server
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=15
LimitNOFILE=65536
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
